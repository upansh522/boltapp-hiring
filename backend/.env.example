# Django Settings
DEBUG=True
SECRET_KEY=replace-with-a-unique-local-development-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration - Individual Environment Variables
# Split from DATABASE_URL for easier management per PRD #23
DB_HOST=127.0.0.1
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432
DB_SSLMODE=disable

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authenticated checkout token lifetime in seconds
CHECKOUT_AUTH_TOKEN_MAX_AGE=900
